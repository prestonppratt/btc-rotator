# Transitional authentication settings. Before AWS production deployment, replace
# this temporary Clerk integration with Amazon Cognito and set its values in Amplify.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Comma-separated, lowercase email allowlist. Leave empty to deny every authenticated user.
APP_ALLOWED_EMAILS=owner@example.com,brother@example.com

# Provision these before enabling live research. Never expose them to the browser.
DATABASE_URL=
MARKET_DATA_API_KEY=
BTC_INDEX_API_KEY=
SENTRY_DSN=
